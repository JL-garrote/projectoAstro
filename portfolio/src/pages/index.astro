---
import Layout from "../layouts/Layout.astro";
import Window from "../components/os/Window.astro";
import Icon from "../components/os/Icon.astro";
import AboutApp from "../components/os/apps/AboutApp.astro";
import ProjectsApp from "../components/os/apps/ProjectsApp.astro";
import StackApp from "../components/os/apps/StackApp.astro";
import TrayectoriaApp from "../components/os/apps/TrayectoriaApp.astro";
import ContactApp from "../components/os/apps/ContactApp.astro";
import TerminalApp from "../components/os/apps/TerminalApp.astro";
import { apps, perfil, redes } from "../data/portfolio";

const contenido = {
	"sobre-mi": AboutApp,
	proyectos: ProjectsApp,
	stack: StackApp,
	trayectoria: TrayectoriaApp,
	contacto: ContactApp,
	terminal: TerminalApp,
};
---

<Layout>
	<div class="boot" id="boot" aria-hidden="true">
		<pre class="boot-log" id="boot-log"></pre>
		<p class="boot-skip">Pulsa cualquier tecla o haz clic para saltar</p>
	</div>

	<div class="os">
		<header class="topbar">
			<button class="start-btn" id="start-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="start-menu">
				<span class="logo-mark" aria-hidden="true"></span> JL-OS
			</button>
			<span class="active-app" id="active-app">Escritorio</span>
			<div class="topbar-right">
				<span class="status-pill mono"><span class="pulse-dot"></span>{perfil.estado}</span>
				<time class="clock" id="clock"></time>
			</div>

			<div class="start-menu" id="start-menu" role="menu" hidden>
				<p class="mono">{perfil.nombre}</p>
				<ul>
					{apps.map((app) => (
						<li>
							<button class="menu-item" type="button" role="menuitem" data-open={app.id}>
								<Icon name={app.icono} size={16} /> {app.nombre}
							</button>
						</li>
					))}
				</ul>
				<div class="menu-sep"></div>
				<ul>
					{redes.map((r) => (
						<li>
							<a class="menu-item" role="menuitem" href={r.href} target="_blank" rel="noopener noreferrer">
								<Icon name={r.label.toLowerCase()} size={16} /> {r.label}
							</a>
						</li>
					))}
					<li class="desktop-only">
						<button class="menu-item" type="button" role="menuitem" id="reset-icons">
							<Icon name="grid" size={16} /> Ordenar iconos
						</button>
					</li>
					<li>
						<button class="menu-item" type="button" role="menuitem" id="reboot">
							<Icon name="power" size={16} /> Reiniciar
						</button>
					</li>
				</ul>
			</div>
		</header>

		<main class="desktop" id="desktop" tabindex="-1">
			<div class="wallpaper-mark">
				<span class="status-pill mono"><span class="pulse-dot"></span>{perfil.estado}</span>
				<p class="wallpaper-logo">JL-OS</p>
				<p class="wallpaper-sub">{perfil.nombre} · {perfil.rol}</p>
			</div>

			<ul class="desktop-icons" aria-label="Aplicaciones">
				{apps.map((app, i) => (
					<li style={`--i:${i}`}>
						<button class="desk-icon" type="button" data-open={app.id}>
							<span class="desk-icon-box"><Icon name={app.icono} size={26} /></span>
							{app.nombre}
						</button>
					</li>
				))}
			</ul>

			{apps.map((app) => {
				const Contenido = contenido[app.id];
				return (
					<Window app={app}>
						<Contenido />
					</Window>
				);
			})}

			<nav class="dock" aria-label="Dock">
				{apps.map((app) => (
					<button class="dock-btn" type="button" data-launch={app.id} aria-label={app.nombre}>
						<Icon name={app.icono} size={22} />
						<span class="dock-tip" aria-hidden="true">{app.nombre}</span>
					</button>
				))}
			</nav>
		</main>
	</div>
</Layout>

<script>
	import { closeStartMenu } from "../scripts/os";
	import { resetIcons } from "../scripts/desktop-icons";

	document.getElementById("reset-icons")?.addEventListener("click", () => {
		resetIcons();
		closeStartMenu();
	});
</script>
