---
const tituloHeader = "Juan Luis Gil Garrote";

const opcionesHeader = [
	{ label: "Inicio", href: "/" },
	{ label: "Sobre mí", href: "/#sobre-mi" },
	{ label: "Proyectos", href: "/#projects" },
	{ label: "Contacto", href: "/contact" },
];
---

<header class="site-header">
	<h1 class="logo">{tituloHeader}</h1>

	<div class="navigation">
		<nav>
			<ul>
				{
					opcionesHeader.map((opcion) => (
						<li>
							<a href={opcion.href}> {opcion.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		display: flex;
		justify-content: space-between; /* Separa logo, menú y botón equitativamente */
		align-items: center; /* Centra todo verticalmente */
		padding: var(--gap-md) var(--margin-desktop); /* Usa tus variables de espacio */
		background-color: transparent; /* O var(--surface) si quieres fondo sólido */
		border-bottom: 1px solid var(--outline-variant);
	}

	/* Estilos del Logo */
	.logo {
		color: var(--primary);
		font-size: 24px;
		font-weight: 800;
		margin: 0;
		letter-spacing: -0.02em;
	}

	/* Estilos del Menú (La lista UL) */
	.navigation ul {
		display: flex;
		gap: var(--gap-md); /* Espaciado entre cada opción del menú */
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* Estilos de los enlaces del menú */
	.navigation a {
		color: var(--on-surface-variant);
		font-family:
			"JetBrains Mono", "Fira Code", monospace; /* Estilo código como tu diseño */
		font-size: 14px;
		text-decoration: none;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.navigation a:hover {
		color: var(--primary);
	}

	@media (max-width: 900px) {
		.site-header {
			padding: var(--gap-md) 20px;
		}
	}

	@media (max-width: 600px) {
		.site-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 14px;
		}

		.logo {
			font-size: 20px;
		}

		.navigation ul {
			flex-wrap: wrap;
			gap: 16px;
			row-gap: 8px;
		}
	}
</style>
