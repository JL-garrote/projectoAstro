---

<section id="trayectoria" class="trayectoria-section">
    <div class="trayectoria-header" id="tr-header">
        <span class="subtitle-tech text-code-md">Trayectoria</span>
        <h3 class="trayectoria-title">Experiencia &amp; Educación</h3>
    </div>

    <div class="hero-container">
    <!-- COLUMNA IZQUIERDA: EXPERIENCIA -->
    <div class="col">
        <h2 class="section-title">Experiencia</h2>

        <div class="entry">
            <div class="entry-marker"></div>
            <div class="entry-body">
                <div class="entry-top">
                    <h3 class="entry-role">Desarrollador Full Stack</h3>
                    <span class="entry-date">3 meses — PRESENCIAL.</span>
                </div>
                <p class="entry-company">
                    Elenco Ahorro - Mairena del Aljarafe
                </p>
                <p class="entry-desc">
                    Gestión y planificación integral de un proyecto CRM-ERP para
                    consultoría energética: análisis de requisitos con negocio,
                    diseño funcional, desarrollo y puesta en producción. Diseño
                    de la arquitectura API REST desacoplada: frontend en Next.js
                    sobre Vercel y backend en TypeScript / TypeORM sobre AWS,
                    con pipelines de despliegue independientes. Desarrollo de
                    módulos de gestión de contratos, campañas y cartera de
                    clientes, con cuadros de mando y control de KPIs comerciales
                    para la toma de decisiones. Modelado de la base de datos y
                    dirección del paso a producción: migración completa de datos
                    entre entornos sin interrupción del servicio ni pérdida de
                    información..
                </p>
            </div>
        </div>

        <div class="entry">
            <div class="entry-marker"></div>
            <div class="entry-body">
                <div class="entry-top">
                    <h3 class="entry-role">Técnico de Sistemas</h3>
                    <span class="entry-date">3 meses — PRESENCIAL.</span>
                </div>
                <p class="entry-company">Axona.SLR - Pavia (Italia)</p>
                <p class="entry-desc">
                    Mantenimiento y administración de infraestructura de red.
                    Soporte técnico a usuarios y gestión de incidencias.
                    Mantenimiento de sistemas informáticos y servidores locales.
                </p>
            </div>
        </div>
    </div>

    <!-- COLUMNA DERECHA: EDUCACIÓN -->
    <div class="col">
        <h2 class="section-title">Educación</h2>

        <div class="entry">
            <div class="entry-marker"></div>
            <div class="entry-body">
                <div class="entry-top">
                    <h3 class="entry-role">
                        Desarrollo de Aplicaciones Multiplataforma
                    </h3>
                    <span class="entry-date">2024 — 2026</span>
                </div>
                <p class="entry-company">
                    CFGS — FORMACIÓN PROFESIONAL DE GRADO SUPERIOR
                </p>
                <p class="entry-desc">
                    Formación en desarrollo de aplicaciones multiplataforma.
                    Especialización en tecnologías Java, Kotlin y desarrollo
                    móvil.
                </p>
            </div>
        </div>

        <div class="entry">
            <div class="entry-marker"></div>
            <div class="entry-body">
                <div class="entry-top">
                    <h3 class="entry-role">
                        Técnico en Sistemas Microinformáticos y Redes
                    </h3>
                    <span class="entry-date">2021 — 2023</span>
                </div>
                <p class="entry-company">
                    CFGM — FORMACIÓN PROFESIONAL DE GRADO MEDIO
                </p>
                <p class="entry-desc">
                    Formación en mantenimiento de sistemas informáticos y
                    administración de redes locales.
                </p>
            </div>
        </div>
    </div>
    </div>
</section>

<script
    is:inline
    src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"
></script>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;

                    anime({
                        targets: "#tr-header .subtitle-tech",
                        opacity: [0, 1],
                        translateX: [-12, 0],
                        duration: 500,
                        easing: "easeOutExpo",
                    });
                    anime({
                        targets: "#tr-header .trayectoria-title",
                        opacity: [0, 1],
                        translateY: [14, 0],
                        duration: 600,
                        delay: 150,
                        easing: "easeOutExpo",
                    });

                    anime({
                        targets: ".section-title",
                        opacity: [0, 1],
                        translateY: [20, 0],
                        duration: 700,
                        delay: anime.stagger(200, { start: 300 }),
                        easing: "easeOutExpo",
                    });

                    anime({
                        targets: ".entry",
                        opacity: [0, 1],
                        translateY: [24, 0],
                        duration: 700,
                        delay: anime.stagger(120, { start: 550 }),
                        easing: "easeOutExpo",
                    });

                    io.unobserve(entry.target);
                });
            },
            { threshold: 0.15 },
        );

        const section = document.getElementById("trayectoria");
        if (section) io.observe(section);

        document.querySelectorAll(".entry").forEach((entry) => {
            entry.addEventListener("mouseenter", () => {
                anime({
                    targets: entry,
                    translateX: [0, 6],
                    duration: 250,
                    easing: "easeOutQuad",
                });
            });
            entry.addEventListener("mouseleave", () => {
                anime({
                    targets: entry,
                    translateX: [6, 0],
                    duration: 250,
                    easing: "easeOutQuad",
                });
            });
        });
    });
</script>

<style>
    .trayectoria-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: var(--gap-xl, 48px);
    }

    .subtitle-tech {
        color: var(--primary, #00ff9c);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        opacity: 0;
    }

    .trayectoria-title {
        font-size: 38px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.01em;
        opacity: 0;
    }

    .hero-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--gap-xl, 48px);
    }

    .col {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .section-title {
        font-size: 36px;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 36px 0;
        letter-spacing: -0.01em;
        opacity: 0;
    }

    .entry {
        display: flex;
        gap: 16px;
        padding-bottom: 32px;
        margin-bottom: 8px;
        opacity: 0;
        cursor: default;
        position: relative;
    }

    .entry:not(:last-child)::after {
        content: "";
        position: absolute;
        left: 3px;
        top: 10px;
        bottom: -8px;
        width: 1px;
        background: var(--outline-variant, rgba(64, 73, 69, 0.4));
    }

    .entry-marker {
        width: 8px;
        height: 8px;
        background-color: var(--primary, #00ff9c);
        flex-shrink: 0;
        margin-top: 7px;
        position: relative;
        z-index: 1;
    }

    .entry-body {
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .entry-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .entry-role {
        font-size: 20px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.2;
    }

    .entry-date {
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        font-weight: 600;
        color: var(--primary, #00ff9c);
        white-space: nowrap;
        margin-top: 4px;
    }

    .entry-company {
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--on-surface-variant, #8a9994);
        margin: 0;
        text-transform: uppercase;
    }

    .entry-desc {
        font-size: 14px;
        line-height: 1.6;
        color: var(--on-surface-variant, #8a9994);
        margin: 4px 0 0 0;
        max-width: 480px;
    }

    @media (max-width: 768px) {
        .hero-container {
            grid-template-columns: 1fr;
        }
    }
</style>
