---

import teamPulseImage from '../assets/port.png';
import voyagerImage from '../assets/voyager.jpg';
import auraChatImage from '../assets/auraChat.jpg';
import boardSyncImage from '../assets/boardSync.png';
import type { ImageMetadata } from 'astro';

interface Proyecto {
  tagTop: string;
  title: string;
  description: string;
  tags: string[];
  linkSource: string;
  linkLive: string;
  image: ImageMetadata | string | null;
  iconType: "code" | "sparkle" | "shield" | "cpu";
}

const proyectos: Proyecto[] = [
  {
    tagTop: "Production",
    title: "Portfolio Personal",
    description: "",
    tags: ["#Astro.js", "#TailwindCSS", "#Vite"],
    linkSource: "#",
    linkLive: "#",
    image: teamPulseImage,
    iconType: "code"
  },
  {
    tagTop: "Production",
    title: "Voyager",
    description: "Planificador de viajes que estima el gasto real de combustible de tu ruta a partir de las especificaciones exactas de tu vehículo (cilindrada, cv, peso, transmisión, ocupantes...), combinando el trazado de la ruta con la API de Gemini para una predicción contextual.",
    tags: ["#Astro.js", "#SpringBoot", "#Java", "#GeminiAPI"],
    linkSource: "#",
    linkLive: "https://voyager-bice.vercel.app",
    image: voyagerImage,
    iconType: "sparkle"
  },
  {
    tagTop: "Production",
    title: "Aura Chat",
    description: "Chat con IA (Google Gemini) con autenticación propia por JWT, historial de conversaciones persistente y una interfaz Material Design 3 con modo claro/oscuro. Incluye dictado por voz, exportación de conversaciones y notificaciones en cliente.",
    tags: ["#Astro.js", "#SpringBoot", "#TypeScript", "#GeminiAPI"],
    linkSource: "#",
    linkLive: "https://retrograde-resonance-dun.vercel.app",
    image: auraChatImage,
    iconType: "shield"
  },
  {
    tagTop: "v0.1.0",
    title: "BoardSync",
    description: "Tableros Kanban colaborativos: creá tableros, organizalos en columnas, sumá tarjetas y agregá miembros con roles (Editor/Viewer) para trabajar en equipo. Incluye reordenamiento de columnas y tarjetas, y control de concurrencia optimista para evitar que dos ediciones simultáneas se pisen entre sí.",
    tags: ["#React", "#SpringBoot", "#Zustand", "#TailwindCSS"],
    linkSource: "#",
    linkLive: "https://boardsync-frontend.vercel.app/",
    image: boardSyncImage,
    iconType: "cpu"
  }
];
---

<section id="projects" class="projects-section">
  <div class="projects-header" id="pj-header">
    <span class="subtitle-tech text-code-md">Portfolio</span>
    <h3 class="projects-title">Proyectos</h3>
  </div>

  <div class="projects-grid">
    {proyectos.map((project) => (
      <div class="project-card">
        
        <div class="card-image-wrapper">
          <span class="project-status-tag text-code-md">{project.tagTop}</span>
          {project.image ? (
            <img src={typeof project.image === 'string' ? project.image : project.image.src} alt={`Preview de ${project.title}`} />
          ) : (
            <div class="card-image-placeholder">
              {project.iconType === "code" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              )}
              {project.iconType === "sparkle" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              )}
              {project.iconType === "shield" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              )}
              {project.iconType === "cpu" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"></path></svg>
              )}
              <span class="placeholder-label text-code-md">{project.title}</span>
            </div>
          )}
        </div>

        <div class="card-content">
          <div class="card-title-row">
            <h3>{project.title}</h3>
            
            {project.iconType === "code" && (
              <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            )}
            {project.iconType === "sparkle" && (
              <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            )}
            {project.iconType === "shield" && (
              <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            )}
            {project.iconType === "cpu" && (
              <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"></path></svg>
            )}
          </div>

          <p class="project-description">{project.description}</p>

          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="tag text-code-md">{tag}</span>
            ))}
          </div>

          <hr class="card-divider" />

          {(project.linkLive !== "#" || project.linkSource !== "#") && (
            <div class="card-links">
              {project.linkLive !== "#" && (
                <a class="link-item" href={project.linkLive} target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  Ver proyecto
                </a>
              )}
              {project.linkSource !== "#" && (
                <a class="link-item" href={project.linkSource} target="_blank" rel="noopener noreferrer">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  Código
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      anime({
        targets: '#pj-header .subtitle-tech',
        opacity: [0, 1],
        translateX: [-12, 0],
        duration: 500,
        easing: 'easeOutExpo'
      });
      anime({
        targets: '#pj-header .projects-title',
        opacity: [0, 1],
        translateY: [14, 0],
        duration: 600,
        delay: 150,
        easing: 'easeOutExpo'
      });
      anime({
        targets: '.project-card',
        opacity: [0, 1],
        translateY: [28, 0],
        duration: 700,
        delay: anime.stagger(130, { start: 250 }),
        easing: 'easeOutExpo'
      });

      io.unobserve(entry.target);
    });
  }, { threshold: 0.15 });

  const section = document.getElementById('projects');
  if (section) io.observe(section);
});
</script>

<style>
  .projects-section {
    width: 100%;
    background-color: transparent;
  }

  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--gap-xl, 48px);
  }

  .subtitle-tech {
    color: var(--primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0;
  }

  .projects-title {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
    opacity: 0;
  }

  /* Grid elástico idéntico a Figma (3 columnas que bajan a 2 y 1 automáticamente) */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-md);
  }

  /* Estilos base de la tarjeta */
  .project-card {
    border: 1px solid var(--outline-variant);
    background-color: rgba(26, 28, 28, 0.4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-card:hover {
    border-color: rgba(0, 255, 156, 0.3);
  }

  /* Imagen y etiqueta superior */
  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--outline-variant);
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.7) contrast(1.1);
    transition: filter 0.2s ease;
  }

  .project-card:hover .card-image-wrapper img {
    filter: brightness(0.85) contrast(1.1);
  }

  /* Placeholder para proyectos sin captura todavía */
  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: rgba(13, 14, 15, 0.6);
    background-image: radial-gradient(var(--surface-bright) 1px, transparent 1px);
    background-size: 18px 18px;
    color: var(--outline-variant);
  }

  .card-image-placeholder svg {
    color: var(--primary);
    opacity: 0.35;
  }

  .placeholder-label {
    color: var(--on-surface-variant);
    opacity: 0.6;
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  /* Tag flotante estilo terminal */
  .project-status-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: var(--surface-container-lowest);
    border: 1px solid var(--outline-variant);
    color: var(--primary);
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    z-index: 2;
    letter-spacing: 0.05em;
  }

  /* Contenido interno */
  .card-content {
    padding: var(--gap-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .card-title-row h3 {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .tech-icon {
    color: var(--primary);
    filter: drop-shadow(0 0 4px rgba(0, 255, 156, 0.4));
  }

  .project-description {
    color: var(--on-surface-variant);
    font-size: 14px;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex: 1; /* Hace que todas las tarjetas midan lo mismo aunque el texto varíe */
  }

  /* Envase de tags inferiores */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tag {
    border: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    padding: 4px 10px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.02);
  }

  .card-divider {
    border: 0;
    border-top: 1px solid var(--outline-variant);
    margin: 0 0 16px 0;
    width: 100%;
    opacity: 0.5;
  }

  /* Enlaces inferiores */
  .card-links {
    display: flex;
    gap: var(--gap-md);
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--on-surface);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .link-item svg {
    color: var(--on-surface-variant);
    transition: color 0.15s ease;
  }

  .link-item:hover {
    color: var(--primary);
  }

  .link-item:hover svg {
    color: var(--primary);
  }

  /* --- RESPONSIVE --- */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>