---

import voyagerImage from '../assets/voyager.jpg';
import auraChatImage from '../assets/auraChat.jpg';
import boardSyncImage from '../assets/boardSync.png';
import type { ImageMetadata } from 'astro';

interface Proyecto {
  tagTop: string;
  title: string;
  description: string;
  tags: string[];
  linkSource: string;
  linkLive: string;
  image: ImageMetadata | string | null;
  iconType: "code" | "sparkle" | "shield" | "cpu";
  role: string;
  duration: string;
  challenge: string;
  features: string[];
}

const proyectos: Proyecto[] = [
  {
    tagTop: "Production",
    title: "Voyager",
    description: "Planificador de viajes que estima el gasto real de combustible de tu ruta a partir de las especificaciones exactas de tu vehículo (cilindrada, cv, peso, transmisión, ocupantes...), combinando el trazado de la ruta con la API de Gemini para una predicción contextual.",
    tags: ["#Astro.js", "#SpringBoot", "#Java", "#GeminiAPI"],
    linkSource: "#",
    linkLive: "https://voyager-bice.vercel.app",
    image: voyagerImage,
    iconType: "sparkle",
    role: "Full Stack · En solitario",
    duration: "1 mes",
    challenge: "Conectar la IA (Gemini) y la API de Google Maps sin fricciones, para que el trazado de la ruta y la predicción de consumo funcionaran de forma coherente.",
    features: [
      "Estimación del gasto real de combustible según las especificaciones exactas del vehículo (cilindrada, CV, peso, transmisión, ocupantes)",
      "Trazado de ruta con la API de Google Maps",
      "Predicción contextual del consumo con la API de Gemini"
    ]
  },
  {
    tagTop: "Production",
    title: "Aura Chat",
    description: "Chat con IA (Google Gemini) con autenticación propia por JWT, historial de conversaciones persistente y una interfaz Material Design 3 con modo claro/oscuro. Incluye dictado por voz, exportación de conversaciones y notificaciones en cliente.",
    tags: ["#Astro.js", "#SpringBoot", "#TypeScript", "#GeminiAPI"],
    linkSource: "#",
    linkLive: "https://retrograde-resonance-dun.vercel.app",
    image: auraChatImage,
    iconType: "shield",
    role: "Full Stack · En solitario",
    duration: "2 semanas",
    challenge: "Implementar la autenticación propia con JSON Web Tokens (JWT) y gestionar correctamente el flujo de preguntas y respuestas con la IA.",
    features: [
      "Autenticación propia por JWT",
      "Historial de conversaciones persistente",
      "Interfaz Material Design 3 con modo claro/oscuro",
      "Dictado por voz y exportación de conversaciones",
      "Notificaciones en cliente"
    ]
  },
  {
    tagTop: "v0.1.0",
    title: "BoardSync",
    description: "Tableros Kanban colaborativos: creá tableros, organizalos en columnas, sumá tarjetas y agregá miembros con roles (Editor/Viewer) para trabajar en equipo. Incluye reordenamiento de columnas y tarjetas, y control de concurrencia optimista para evitar que dos ediciones simultáneas se pisen entre sí.",
    tags: ["#React", "#SpringBoot", "#Zustand", "#TailwindCSS"],
    linkSource: "#",
    linkLive: "https://boardsync-frontend.vercel.app/",
    image: boardSyncImage,
    iconType: "cpu",
    role: "Full Stack · En solitario",
    duration: "En desarrollo actualmente",
    challenge: "Sincronizar la conectividad entre usuarios en tiempo real, refrescando los tableros compartidos sin interrumpir a los usuarios que están trabajando en ese momento.",
    features: [
      "Tableros Kanban organizados en columnas",
      "Miembros con roles (Editor/Viewer)",
      "Reordenamiento de columnas y tarjetas",
      "Control de concurrencia optimista"
    ]
  }
];

const total = proyectos.length;
---

<section id="projects" class="projects-section">
  <div class="projects-header" id="pj-header">
    <span class="subtitle-tech text-code-md">Portfolio</span>
    <h3 class="projects-title">Proyectos</h3>
  </div>

  <div class="carousel" id="projects-carousel" role="region" aria-roledescription="carrusel" aria-label="Proyectos">

    <div class="carousel-viewport">
      <div class="carousel-track" id="carousel-track">
        {proyectos.map((project, i) => (
          <article
            class="carousel-slide"
            class:list={[{ active: i === 0 }]}
            data-index={i}
            aria-roledescription="slide"
            aria-label={`Proyecto ${i + 1} de ${total}: ${project.title}`}
            aria-hidden={i === 0 ? "false" : "true"}
          >
            <div class="slide-media">
              <span class="project-status-tag text-code-md">{project.tagTop}</span>
              {project.image ? (
                <img src={typeof project.image === 'string' ? project.image : project.image.src} alt={`Captura de ${project.title}`} />
              ) : (
                <div class="card-image-placeholder">
                  {project.iconType === "code" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                  )}
                  {project.iconType === "sparkle" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  )}
                  {project.iconType === "shield" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  )}
                  {project.iconType === "cpu" && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"></path></svg>
                  )}
                  <span class="placeholder-label text-code-md">{project.title}</span>
                </div>
              )}
            </div>

            <div class="slide-details">
              <div class="card-title-row">
                <h3>{project.title}</h3>

                {project.iconType === "code" && (
                  <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                )}
                {project.iconType === "sparkle" && (
                  <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                )}
                {project.iconType === "shield" && (
                  <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                )}
                {project.iconType === "cpu" && (
                  <svg class="tech-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"></path></svg>
                )}
              </div>

              <div class="slide-meta text-code-md">
                <span class="meta-item"><span class="meta-key">Rol</span> {project.role}</span>
                <span class="meta-item"><span class="meta-key">Duración</span> {project.duration}</span>
              </div>

              <p class="project-description">{project.description}</p>

              <div class="slide-block">
                <span class="slide-label text-code-md">Funcionalidades</span>
                <ul class="feature-list">
                  {project.features.map((feature) => (
                    <li><span class="li-arrow">&gt;</span> {feature}</li>
                  ))}
                </ul>
              </div>

              <div class="slide-challenge">
                <span class="slide-label text-code-md">Reto técnico</span>
                <p>{project.challenge}</p>
              </div>

              <div class="slide-block">
                <span class="slide-label text-code-md">Stack</span>
                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag text-code-md">{tag}</span>
                  ))}
                </div>
              </div>

              <hr class="card-divider" />

              {(project.linkLive !== "#" || project.linkSource !== "#") && (
                <div class="card-links">
                  {project.linkLive !== "#" && (
                    <a class="link-item" href={project.linkLive} target="_blank" rel="noopener noreferrer">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                      Ver proyecto
                    </a>
                  )}
                  {project.linkSource !== "#" && (
                    <a class="link-item" href={project.linkSource} target="_blank" rel="noopener noreferrer">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                      Código
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="carousel-controls">
      <button class="carousel-arrow" id="carousel-prev" type="button" aria-label="Proyecto anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="carousel-dots" id="carousel-dots">
        {proyectos.map((project, i) => (
          <button
            class="carousel-dot"
            class:list={[{ active: i === 0 }]}
            type="button"
            data-index={i}
            aria-label={`Ir al proyecto ${i + 1}: ${project.title}`}
            aria-current={i === 0 ? "true" : "false"}
          ></button>
        ))}
      </div>

      <span class="carousel-counter text-code-md" id="carousel-counter">01 / {String(total).padStart(2, "0")}</span>

      <button class="carousel-arrow" id="carousel-next" type="button" aria-label="Proyecto siguiente">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

  </div>
</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {

  /* ── ENTRADA AL SCROLL ── */
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;

      anime({
        targets: '#pj-header .subtitle-tech',
        opacity: [0, 1],
        translateX: [-12, 0],
        duration: 500,
        easing: 'easeOutExpo'
      });
      anime({
        targets: '#pj-header .projects-title',
        opacity: [0, 1],
        translateY: [14, 0],
        duration: 600,
        delay: 150,
        easing: 'easeOutExpo'
      });
      anime({
        targets: '#projects-carousel',
        opacity: [0, 1],
        translateY: [28, 0],
        duration: 700,
        delay: 250,
        easing: 'easeOutExpo'
      });

      io.unobserve(entry.target);
    });
  }, { threshold: 0.15 });

  const section = document.getElementById('projects');
  if (section) io.observe(section);

  /* ── CARRUSEL ── */
  const carousel = document.getElementById('projects-carousel');
  if (!carousel) return;

  const slides   = Array.from(carousel.querySelectorAll('.carousel-slide'));
  const dots     = Array.from(carousel.querySelectorAll('.carousel-dot'));
  const prevBtn  = document.getElementById('carousel-prev');
  const nextBtn  = document.getElementById('carousel-next');
  const counter  = document.getElementById('carousel-counter');
  const total    = slides.length;
  let current    = 0;
  let animating  = false;

  function pad(n) { return String(n).padStart(2, '0'); }

  function goTo(index, direction) {
    if (animating || index === current) return;
    animating = true;

    const outgoing = slides[current];
    const incoming = slides[index];
    const dir = direction === 'prev' ? 1 : -1;

    incoming.style.zIndex = '2';
    outgoing.style.zIndex = '1';
    incoming.setAttribute('aria-hidden', 'false');
    incoming.classList.add('active');

    anime({
      targets: outgoing,
      opacity: [1, 0],
      translateX: [0, dir * -40],
      duration: 320,
      easing: 'easeInExpo'
    });

    anime({
      targets: incoming,
      opacity: [0, 1],
      translateX: [dir * 40, 0],
      duration: 420,
      delay: 90,
      easing: 'easeOutExpo',
      complete: () => {
        outgoing.classList.remove('active');
        outgoing.setAttribute('aria-hidden', 'true');
        animating = false;
      }
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('active', i === index);
      dot.setAttribute('aria-current', i === index ? 'true' : 'false');
    });

    if (counter) counter.textContent = `${pad(index + 1)} / ${pad(total)}`;
    current = index;
  }

  prevBtn?.addEventListener('click', () => goTo((current - 1 + total) % total, 'prev'));
  nextBtn?.addEventListener('click', () => goTo((current + 1) % total, 'next'));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = Number(dot.dataset.index);
      goTo(idx, idx < current ? 'prev' : 'next');
    });
  });

  carousel.setAttribute('tabindex', '0');
  carousel.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') goTo((current - 1 + total) % total, 'prev');
    if (e.key === 'ArrowRight') goTo((current + 1) % total, 'next');
  });

  /* Swipe táctil */
  const viewport = carousel.querySelector('.carousel-viewport');
  let touchStartX = 0;
  let touchDeltaX = 0;

  viewport?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
    touchDeltaX = 0;
  }, { passive: true });

  viewport?.addEventListener('touchmove', (e) => {
    touchDeltaX = e.touches[0].clientX - touchStartX;
  }, { passive: true });

  viewport?.addEventListener('touchend', () => {
    if (Math.abs(touchDeltaX) > 50) {
      if (touchDeltaX < 0) nextBtn?.click();
      else prevBtn?.click();
    }
  });
});
</script>

<style>
  .projects-section {
    width: 100%;
    background-color: transparent;
  }

  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--gap-xl, 48px);
  }

  .subtitle-tech {
    color: var(--primary);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0;
  }

  .projects-title {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
    opacity: 0;
  }

  /* ── CARRUSEL ── */
  .carousel {
    opacity: 0;
    outline: none;
  }

  .carousel-viewport {
    position: relative;
    width: 100%;
  }

  .carousel-track {
    display: grid;
  }

  .carousel-slide {
    grid-row: 1;
    grid-column: 1;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--gap-xl, 48px);
    align-items: stretch;
    border: 1px solid var(--outline-variant);
    background-color: var(--surface-container-low);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .carousel-slide.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Imagen */
  .slide-media {
    position: relative;
    min-height: 280px;
    overflow: hidden;
    border-right: 1px solid var(--outline-variant);
  }

  .slide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.75) contrast(1.1);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: var(--surface-container-lowest);
    background-image: radial-gradient(var(--surface-bright) 1px, transparent 1px);
    background-size: 18px 18px;
    color: var(--outline-variant);
  }

  .card-image-placeholder svg {
    color: var(--primary);
    opacity: 0.35;
  }

  .placeholder-label {
    color: var(--on-surface-variant);
    opacity: 0.6;
    font-size: 12px;
    letter-spacing: 0.05em;
  }

  .project-status-tag {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: var(--surface-container-lowest);
    border: 1px solid var(--outline-variant);
    color: var(--primary);
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    z-index: 2;
    letter-spacing: 0.05em;
  }

  /* Detalle del proyecto */
  .slide-details {
    padding: var(--gap-xl, 48px) var(--gap-xl, 48px) var(--gap-xl, 48px) 0;
    display: flex;
    flex-direction: column;
  }

  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .card-title-row h3 {
    font-size: 30px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .tech-icon {
    color: var(--primary);
    filter: drop-shadow(0 0 4px rgba(0, 255, 156, 0.4));
    flex-shrink: 0;
  }

  .slide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .meta-item {
    color: var(--on-surface-variant);
    font-size: 12px;
    letter-spacing: 0.03em;
  }

  .meta-key {
    color: var(--primary);
    font-weight: 700;
    margin-right: 6px;
  }

  .project-description {
    color: var(--on-surface-variant);
    font-size: 15px;
    line-height: 1.7;
    margin: 0 0 24px 0;
  }

  .slide-block {
    margin-bottom: 24px;
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    border-left: 1px solid var(--outline-variant);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .feature-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--on-surface-variant);
  }

  .li-arrow {
    color: var(--primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .slide-challenge {
    border-left: 3px solid var(--primary);
    background-color: var(--surface-container-lowest);
    padding: 14px 16px;
    margin-bottom: 24px;
  }

  .slide-challenge .slide-label {
    margin-bottom: 6px;
  }

  .slide-challenge p {
    color: var(--on-surface-variant);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  .slide-label {
    display: block;
    color: var(--primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
    opacity: 0.85;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    border: 1px solid var(--outline-variant);
    color: var(--on-surface-variant);
    padding: 5px 12px;
    font-size: 12px;
    background-color: var(--surface-container-lowest);
  }

  .card-divider {
    border: 0;
    border-top: 1px solid var(--outline-variant);
    margin: auto 0 20px 0;
    width: 100%;
    opacity: 0.5;
  }

  .card-links {
    display: flex;
    gap: var(--gap-md);
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--on-surface);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
  }

  .link-item svg {
    color: var(--on-surface-variant);
    transition: color 0.15s ease;
  }

  .link-item:hover {
    color: var(--primary);
  }

  .link-item:hover svg {
    color: var(--primary);
  }

  /* Controles */
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: var(--gap-md, 24px);
  }

  .carousel-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--outline-variant);
    background-color: var(--surface-container-lowest);
    color: var(--on-surface);
    flex-shrink: 0;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .carousel-arrow:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
