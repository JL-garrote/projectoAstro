---
import { Image } from "astro:assets";
import foto from "../../../assets/foto.png";
import { perfil } from "../../../data/portfolio";
---

<div class="about">
	<div class="about-hero">
		<div class="about-photo">
			<Image src={foto} alt={perfil.nombre} width={480} loading="eager" />
			<span class="photo-tag mono">v2.4.0_STABLE</span>
		</div>
		<div class="about-intro">
			<span class="status-pill mono"><span class="pulse-dot"></span>{perfil.estado}</span>
			<h1 class="about-title">Desarrollador <span class="accent">FULLSTACK</span></h1>
			<p class="about-name mono">{perfil.nombre} · {perfil.ubicacion}</p>
			<p class="about-lead">{perfil.resumen}</p>
			<div class="about-actions">
				<button type="button" class="btn btn-primary" data-open="proyectos">Mis proyectos <span aria-hidden="true">→</span></button>
				<button type="button" class="btn btn-ghost" data-open="contacto">Contacto</button>
			</div>
		</div>
	</div>

	<div class="about-body">
		<p class="section-label mono">// cat sobre_mi.txt</p>
		<p>{perfil.sobreMi}</p>
		<ul class="arrow-list">
			{perfil.destacados.map((d) => <li>{d}</li>)}
		</ul>
	</div>
</div>

<style>
	.about {
		padding: 28px;
	}
	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 220px) 1fr;
		gap: 28px;
		align-items: center;
	}
	.about-photo {
		position: relative;
		border: 1px solid var(--line);
		padding: 6px;
		background: var(--bg-deep);
	}
	.about-photo img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		filter: grayscale(0.25) contrast(1.05);
	}
	.photo-tag {
		position: absolute;
		right: -1px;
		bottom: -10px;
		font-size: 10px;
		padding: 2px 6px;
		background: var(--accent);
		color: var(--on-accent);
	}
	.about-title {
		font-size: clamp(28px, 6cqi, 48px);
		line-height: 1.05;
		margin: 14px 0 6px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.about-name {
		color: var(--muted);
		font-size: 13px;
		margin: 0 0 14px;
	}
	.about-lead {
		color: var(--text-soft);
		margin: 0 0 20px;
	}
	.about-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}
	.about-body {
		margin-top: 32px;
		padding-top: 24px;
		border-top: 1px dashed var(--line);
		color: var(--text-soft);
	}
	.about-body p:not(.section-label) {
		margin: 0 0 16px;
	}

	@container (max-width: 560px) {
		.about-hero {
			grid-template-columns: 1fr;
		}
		.about-photo {
			max-width: 180px;
		}
	}
</style>
