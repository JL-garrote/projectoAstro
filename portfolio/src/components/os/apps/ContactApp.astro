---
import { perfil, redes } from "../../../data/portfolio";
import Icon from "../Icon.astro";
---

<div class="mail">
	<form class="mail-form" id="contact-form" novalidate>
		<div class="mail-row reveal" style="--i:0">
			<span class="mail-key mono">Para:</span>
			<span class="mail-to">{perfil.nombre}</span>
		</div>
		<label class="mail-row reveal" style="--i:1">
			<span class="mail-key mono">De:</span>
			<input name="from_name" type="text" placeholder="Tu nombre" required autocomplete="name" />
		</label>
		<label class="mail-row reveal" style="--i:2">
			<span class="mail-key mono">Email:</span>
			<input name="from_email" type="email" placeholder="tu@correo.com" required autocomplete="email" />
		</label>
		<label class="mail-body reveal" style="--i:3">
			<span class="sr-only">Mensaje</span>
			<textarea name="message" rows="8" placeholder="Cuéntame tu idea o propuesta..." required></textarea>
		</label>

		<div class="mail-actions reveal" style="--i:4">
			<p class="mail-status mono" id="contact-status" role="status" aria-live="polite">&gt; listo para enviar</p>
			<button class="btn btn-primary" type="submit" id="contact-submit">
				<Icon name="send" size={14} /> Enviar
			</button>
		</div>
	</form>

	<aside class="mail-links reveal" style="--i:5">
		<span class="mono muted">También en:</span>
		{redes.map((r) => (
			<a href={r.href} target="_blank" rel="noopener noreferrer">
				<Icon name={r.label.toLowerCase()} size={16} />
				{r.label}
			</a>
		))}
	</aside>
</div>

<script>
	// EmailJS (API REST): mismas credenciales públicas que el formulario anterior
	const EMAILJS = {
		service_id: "service_9smuobg",
		template_id: "template_ktjilop",
		user_id: "l4-yuFeM2N6y-3qRj",
	};

	const form = document.getElementById("contact-form") as HTMLFormElement;
	const status = document.getElementById("contact-status")!;
	const submit = document.getElementById("contact-submit") as HTMLButtonElement;

	function setStatus(text: string, state: "idle" | "busy" | "ok" | "error" = "idle") {
		status.textContent = `> ${text}`;
		status.dataset.state = state;
		status.classList.remove("is-changing");
		void status.offsetWidth;
		status.classList.add("is-changing");
	}

	form.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			setStatus("revisa los campos: todos son obligatorios y el email debe ser válido", "error");
			form.reportValidity();
			return;
		}

		const data = new FormData(form);
		const email = String(data.get("from_email"));
		submit.disabled = true;
		setStatus("transmitiendo...", "busy");

		try {
			const res = await fetch("https://api.emailjs.com/api/v1.0/email/send", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					...EMAILJS,
					template_params: {
						from_name: data.get("from_name"),
						from_email: email,
						message: data.get("message"),
						reply_to: email,
					},
				}),
			});
			if (!res.ok) throw new Error(await res.text());
			form.reset();
			setStatus("mensaje enviado. ¡Gracias! Te responderé pronto.", "ok");
		} catch (err) {
			console.error(err);
			setStatus("error al enviar. Inténtalo de nuevo o escríbeme por LinkedIn.", "error");
		} finally {
			submit.disabled = false;
		}
	});
</script>

<style>
	.mail {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.mail-form {
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.mail-row {
		position: relative;
		transition: background 0.2s ease;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 20px;
		min-height: 46px;
		border-bottom: 1px solid var(--line);
	}
	.mail-key {
		width: 56px;
		flex-shrink: 0;
		font-size: 12px;
		color: var(--muted);
	}
	.mail-to {
		font-size: 14px;
		padding: 2px 8px;
		background: var(--accent-soft);
		border: 1px solid var(--accent-line);
		color: var(--accent);
	}
	input,
	textarea {
		flex: 1;
		width: 100%;
		background: transparent;
		border: 0;
		color: var(--text);
		font: inherit;
		font-size: 15px;
		padding: 12px 0;
		outline: none;
	}
	textarea {
		resize: none;
		height: 100%;
		min-height: 160px;
		padding: 16px 20px;
	}
	.mail-body {
		display: flex;
		flex: 1;
	}
	/* Línea de foco que se extiende desde la izquierda */
	.mail-row::after,
	.mail-body::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s var(--ease-out);
	}
	.mail-body {
		position: relative;
	}
	.mail-row:focus-within::after,
	.mail-body:focus-within::after {
		transform: scaleX(1);
	}
	.mail-row:focus-within {
		background: var(--hover);
	}
	.mail-key {
		transition: color 0.2s ease;
	}
	.mail-row:focus-within .mail-key {
		color: var(--accent);
	}
	::placeholder {
		color: var(--muted);
		opacity: 0.7;
	}
	.mail-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 20px;
		border-top: 1px solid var(--line);
		background: var(--bg-deep);
	}
	.mail-status.is-changing {
		animation: status-in 0.35s var(--ease-out);
	}
	.mail-status[data-state="busy"]::after {
		content: "";
		display: inline-block;
		width: 0.9em;
		height: 0.9em;
		margin-left: 8px;
		vertical-align: -0.1em;
		border: 1.5px solid currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		animation: spin 0.7s linear infinite;
	}
	@keyframes status-in {
		from {
			opacity: 0;
			transform: translateX(-6px);
		}
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	.mail-status {
		margin: 0;
		font-size: 12px;
		color: var(--muted);
	}
	.mail-status[data-state="busy"] {
		color: var(--warn);
	}
	.mail-status[data-state="ok"] {
		color: var(--accent);
	}
	.mail-status[data-state="error"] {
		color: var(--danger);
	}
	.btn:disabled {
		opacity: 0.5;
	}
	.mail-links {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
		padding: 12px 20px;
		border-top: 1px solid var(--line);
		font-size: 14px;
	}
	.muted {
		color: var(--muted);
		font-size: 12px;
	}
	.mail-links a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--text-soft);
		text-decoration: none;
		transition:
			color 0.2s ease,
			transform 0.25s var(--ease-spring);
	}
	.mail-links a:hover {
		transform: translateY(-2px);
		color: var(--accent);
	}

	@container (max-width: 440px) {
		.mail-actions {
			flex-direction: column;
			align-items: stretch;
		}
	}
</style>
