---
import { experiencia, educacion } from "../../../data/portfolio";

const columnas = [
	{ titulo: "Experiencia", archivo: "experiencia.log", entradas: experiencia },
	{ titulo: "Educación", archivo: "educacion.log", entradas: educacion },
];
---

<div class="logs">
	{columnas.map((col, ci) => (
		<section class="log-col">
			<h2 class="log-title reveal" style={`--i:${ci}`}>
				<span class="mono muted">$ tail</span> {col.archivo}
			</h2>
			<ol class="timeline">
				{col.entradas.map((e, i) => (
					<li class="entry reveal" style={`--i:${ci + 1 + i * 1.5}`}>
						<span class="entry-date mono">[{e.fecha}]</span>
						<h3 class="entry-role">{e.titulo}</h3>
						<p class="entry-place mono">@ {e.lugar}</p>
						<p class="entry-desc">{e.descripcion}</p>
					</li>
				))}
			</ol>
		</section>
	))}
</div>

<style>
	.logs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		padding: 24px 28px 32px;
	}
	.log-title {
		font-size: 18px;
		margin: 0 0 20px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--line);
	}
	.muted {
		color: var(--muted);
		font-size: 13px;
		font-weight: 400;
	}
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.entry {
		position: relative;
		padding: 0 0 26px 22px;
		border-left: 1px solid var(--line);
	}
	.entry:last-child {
		padding-bottom: 0;
	}
	.entry::before {
		transition:
			box-shadow 0.3s ease,
			background 0.3s ease;
		content: "";
		position: absolute;
		left: -5px;
		top: 4px;
		width: 9px;
		height: 9px;
		background: var(--bg);
		border: 1px solid var(--accent);
	}
	.entry:hover::before {
		background: var(--accent);
		box-shadow: 0 0 12px var(--accent);
	}
	.entry-role {
		transition: color 0.2s ease;
	}
	.entry:hover .entry-role {
		color: var(--accent);
	}
	.entry:first-child::before {
		background: var(--accent);
		box-shadow: 0 0 10px var(--accent);
	}
	.entry-date {
		font-size: 12px;
		color: var(--accent);
	}
	.entry-role {
		font-size: 17px;
		margin: 6px 0 4px;
		line-height: 1.3;
	}
	.entry-place {
		font-size: 12px;
		color: var(--muted);
		margin: 0 0 10px;
	}
	.entry-desc {
		margin: 0;
		color: var(--text-soft);
		font-size: 14px;
	}

	@container (max-width: 700px) {
		.logs {
			grid-template-columns: 1fr;
			padding: 18px 16px 28px;
		}
	}
</style>
