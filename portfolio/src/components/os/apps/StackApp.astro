---
import { stack } from "../../../data/portfolio";
---

<div class="monitor">
	<div class="monitor-head mono">
		<span>PID</span>
		<span>PROCESO</span>
		<span class="col-load">CARGA</span>
	</div>

	{stack.map((grupo, i) => (
		<section class="proc">
			<div class="proc-row mono">
				<span class="pid">{String(1024 + i * 7)}</span>
				<span class="proc-name">
					<strong>{grupo.titulo}</strong>
					<span class="muted">{grupo.proceso}</span>
				</span>
				<span class="col-load">
					<span class="bar" aria-hidden="true"><span class="bar-fill" style={`--w:${grupo.nivel}%`}></span></span>
					<span class="pct">{grupo.nivel}%</span>
				</span>
			</div>
			<ul class="chips">
				{grupo.items.map((t) => (
					<li class="chip">
						{t.devicon ? <i class={t.devicon} aria-hidden="true"></i> : <span class="chip-dot" aria-hidden="true"></span>}
						{t.nombre}
					</li>
				))}
			</ul>
		</section>
	))}

	<p class="monitor-foot mono">
		<span class="pulse-dot"></span>
		{stack.reduce((n, g) => n + g.items.length, 0)} módulos cargados · sistema estable
	</p>
</div>

<style>
	.monitor {
		padding: 20px 24px 24px;
	}
	.monitor-head,
	.proc-row {
		display: grid;
		grid-template-columns: 56px 1fr minmax(140px, 38%);
		gap: 16px;
		align-items: center;
	}
	.monitor-head {
		font-size: 11px;
		color: var(--muted);
		padding: 0 0 10px;
		border-bottom: 1px solid var(--line);
	}
	.proc {
		padding: 18px 0;
		border-bottom: 1px dashed var(--line);
	}
	.proc-row {
		font-size: 13px;
	}
	.pid {
		color: var(--muted);
	}
	.proc-name {
		display: flex;
		gap: 10px;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.proc-name strong {
		font-family: var(--font-sans);
		font-size: 17px;
		color: var(--text);
	}
	.muted {
		color: var(--muted);
		font-size: 12px;
	}
	.col-load {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.bar {
		flex: 1;
		height: 8px;
		background: var(--bg-deep);
		border: 1px solid var(--line);
		overflow: hidden;
	}
	.bar-fill {
		display: block;
		height: 100%;
		width: var(--w);
		background: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 8px);
		transform-origin: left;
		animation: fill 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	.pct {
		color: var(--accent);
		width: 3.5ch;
		text-align: right;
	}
	.chips {
		list-style: none;
		margin: 14px 0 0;
		padding: 0 0 0 72px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border: 1px solid var(--line);
		background: var(--bg-deep);
		font-size: 13px;
		color: var(--text-soft);
	}
	.chip i {
		font-size: 16px;
		color: var(--accent);
	}
	.chip-dot {
		width: 6px;
		height: 6px;
		background: var(--accent);
	}
	.monitor-foot {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 18px 0 0;
		font-size: 12px;
		color: var(--muted);
	}

	@keyframes fill {
		from {
			transform: scaleX(0);
		}
	}

	@container (max-width: 520px) {
		.monitor {
			padding: 16px;
		}
		.monitor-head {
			display: none;
		}
		.proc-row {
			grid-template-columns: 1fr;
			gap: 10px;
		}
		.pid {
			display: none;
		}
		.chips {
			padding-left: 0;
		}
	}
</style>
